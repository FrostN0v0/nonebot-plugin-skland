limit_req_zone $binary_remote_addr zone=maa_remote:1m rate=5r/s;
limit_conn_zone $binary_remote_addr zone=maa_perip:1m;
limit_conn_zone $server_name zone=maa_total:1m;

server {
    listen 80;
    server_name <MAA_HOST>;
    access_log off;
    error_log <NGINX_LOG_DIR>/error.log warn;
    server_tokens off;
    location ^~ /.well-known/acme-challenge/ {
        root <ACME_WEBROOT>;
        default_type text/plain;
    }
    location / { return 404; }
}

server {
    listen 443 ssl;
    server_name <MAA_HOST>;
    ssl_certificate <CERT_CHAIN_PATH>;
    ssl_certificate_key <CERT_KEY_PATH>;
    ssl_protocols TLSv1.2 TLSv1.3;
    access_log off;
    error_log <NGINX_LOG_DIR>/error.log warn;
    server_tokens off;
    client_header_timeout 10s;
    client_body_timeout 10s;
    keepalive_timeout 10s;
    send_timeout 15s;
    limit_req_status 429;
    limit_conn_status 429;
    limit_conn maa_perip 4;
    limit_conn maa_total 24;

    location = /maa/getTask {
        limit_req zone=maa_remote burst=20 nodelay;
        limit_except POST { deny all; }
        client_max_body_size 4k;
        proxy_pass http://127.0.0.1:<GATEWAY_PORT>;
        proxy_connect_timeout 3s;
        proxy_read_timeout 20s;
    }
    location = /maa/reportStatus {
        limit_req zone=maa_remote burst=20 nodelay;
        limit_except POST { deny all; }
        client_max_body_size 12m;
        limit_conn maa_perip 1;
        limit_conn maa_total 2;
        # Prevent screenshot/credential bodies from being spooled to disk by nginx.
        proxy_request_buffering off;
        proxy_http_version 1.1;
        proxy_pass http://127.0.0.1:<GATEWAY_PORT>;
        proxy_connect_timeout 3s;
        proxy_read_timeout 30s;
    }
    location / { return 404; }
}
