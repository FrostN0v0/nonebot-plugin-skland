{% autoescape true %}
{% set titles = {
  'overview': '角色档案',
  'bind_confirmation': '确认绑定角色',
  'unbind_selection': '选择解绑账号',
  'unbind_confirmation': '解绑确认'
} %}
{% set subtitles = {
  'overview': '当前使用角色与绑定信息',
  'bind_confirmation': '请核对待绑定或更新的账号与角色',
  'unbind_selection': '根据角色信息选择要解绑的账号',
  'unbind_confirmation': '请核对待移除的账号与游戏角色'
} %}
{% set games = [
  {'code': 'arknights', 'title': '明日方舟', 'wordmark': '../images/ark_card/raft_dec_text_01.png'},
  {'code': 'endfield', 'title': '明日方舟：终末地', 'wordmark': '../images/endfield/name_title.png'}
] %}
{% macro role_row(role, game) %}
<div class="relative flex min-w-0 gap-4 py-4">
  <div class="flex w-11 shrink-0 flex-col items-center border-r border-[#080808]/10 pr-3">
    <span class="font-[Akrobat] text-[30px] leading-8 {% if role.is_available %}text-[#080808]/75{% else %}text-[#080808]/35{% endif %}">{{ '%02d' | format(role.index) if role.index is not none else '—' }}</span>
    {% if role.index is not none %}
    <span class="mt-1 text-[10px] tracking-wider text-[#080808]/60">序号</span>
    {% endif %}
  </div>
  <div class="min-w-0 flex-1">
    <div class="flex min-w-0 flex-wrap items-center justify-between gap-x-3 gap-y-2">
      <h3 class="min-w-0 break-all text-[22px] leading-7 font-bold tracking-[0.025em] {% if role.is_available %}text-[#080808]/90{% else %}text-[#080808]/55{% endif %}">{{ role.nickname }}</h3>
      {% if role.is_local_default %}
      <span class="inline-flex shrink-0 items-center border-l-2 px-2 py-0.5 text-[11px] font-bold {% if game.code == 'arknights' %}border-[#23BAFC] bg-[#23BAFC]/15 text-[#16445B]{% else %}border-[#9A9400] bg-[#E3D600]/25 text-[#4D4B12]{% endif %}">插件默认</span>
      {% endif %}
      {% if not role.is_available %}
      <span class="border-l-2 border-[#D0685E] bg-[#D0685E]/10 px-2 py-0.5 text-[11px] font-bold text-[#944940]">{{ role.unavailable_reason }}</span>
      {% endif %}
    </div>
    <div class="mt-2 flex min-w-0 flex-wrap items-center gap-x-2 gap-y-1 text-[12px] text-[#080808]/65">
      <span class="shrink-0 text-[10px] text-[#080808]/50">区服</span>
      <span class="min-w-0 break-all">{{ role.server_label }}</span>
      {% if role.is_skland_default %}
      <span class="ml-auto flex shrink-0 items-center gap-1.5 text-[11px] text-[#080808]/65"><span class="size-1 rotate-45 border border-[#080808]/50"></span>森空岛默认</span>
      {% endif %}
    </div>
    <div class="mt-3 flex min-w-0 gap-3 border-t border-[#080808]/10 pt-2.5 font-[Bender] text-[13px] leading-4">
      <span class="w-7 shrink-0 text-[11px] tracking-wider text-[#080808]/50">UID</span>
      <span class="min-w-0 break-all tracking-[0.04em] text-[#080808]/80">{{ role.player_uid }}</span>
    </div>
  </div>
</div>
{% endmacro %}
<!DOCTYPE html>
<html lang="zh-CN">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{{ titles[props.mode] }}</title>
  <style>
    {% include 'index.css' %}
  </style>
</head>
<body class="m-0 bg-[#111111] font-sans">
<main class="bound-roles-dossier relative w-[706px] overflow-hidden text-[#080808]">
  <header class="bound-roles-header relative overflow-hidden px-[30px] pt-7 pb-6 text-white">
    <div class="bound-roles-hatch pointer-events-none absolute -top-8 right-[-35px] h-[200px] w-[170px] -rotate-[14deg] opacity-25"></div>
    <div class="relative z-10 flex items-start justify-between gap-4">
      <div class="min-w-0">
        <div class="flex items-center gap-2 text-[11px] tracking-widest text-white/65"><span class="h-1.5 w-1.5 bg-[#23BAFC]"></span>森空岛</div>
        <h1 class="mt-2.5 text-[32px] leading-10 font-bold tracking-[0.1em]">{{ titles[props.mode] }}</h1>
        <p class="mt-2 text-[12px] tracking-wide text-white/65">{{ subtitles[props.mode] }}</p>
      </div>
      <div class="relative mt-1 flex shrink-0 items-center gap-4 border-l border-white/15 pl-5">
        <div class="text-right"><div class="font-[Akrobat] text-[40px] leading-10 text-white/90">{{ '%02d' | format(props.accounts | length) }}</div><div class="mt-1 text-[11px] tracking-widest text-white/65">账号</div></div>
        <div class="text-right"><div class="font-[Akrobat] text-[40px] leading-10 text-white/90">{{ '%02d' | format(props.accounts | map(attribute='roles') | map('length') | sum) }}</div><div class="mt-1 text-[11px] tracking-widest text-white/65">角色</div></div>
      </div>
    </div>
  </header>
  <div class="flex h-1.5"><span class="w-8 bg-[#92999C]"></span><span class="flex-1 bg-[#23BAFC]"></span><span class="flex-1 bg-[#E3D600]"></span></div>

  {% if props.accounts %}
  <div class="space-y-5 px-[30px] pt-6">
    {% for account in props.accounts %}
    <article class="bound-roles-account overflow-hidden rounded-[4px] border {% if account.state == 'pending_unbind' %}border-[#D0685E]/85{% else %}border-white/35{% endif %}">
      <header class="relative flex min-h-[48px] items-center justify-between gap-3 px-4 py-2 text-white {% if account.state == 'pending_unbind' %}bg-[#423437]{% else %}bg-[#272E32]/95{% endif %}">
        <div class="flex items-center gap-3"><span class="text-[11px] tracking-widest text-white/65">账号</span><span class="font-[Akrobat] text-[26px] leading-7">{{ '%02d' | format(account.index) }}</span></div>
        {% if account.state == 'pending_unbind' %}
        <span class="flex items-center gap-2 text-[11px] font-bold text-[#FFAFA3]"><span class="h-3 w-0.5 bg-[#E48274]"></span>待解绑</span>
        {% elif account.state == 'pending_bind' %}
        <span class="flex items-center gap-2 text-[11px] font-bold text-[#67D0FF]"><span class="h-3 w-0.5 bg-[#23BAFC]"></span>待绑定</span>
        {% elif account.state == 'pending_update' %}
        <span class="flex items-center gap-2 text-[11px] font-bold text-[#E9CF63]"><span class="h-3 w-0.5 bg-[#E9CF63]"></span>待更新</span>
        {% else %}
        <span class="flex items-center gap-2 text-[10px] tracking-wider text-white/60"><span class="h-1 w-1 bg-white/40"></span>已绑定</span>
        {% endif %}
      </header>
      <div class="divide-y divide-[#080808]/10 bg-[#F4F5EF]/75 px-4">
        {% for game in games %}
        {% set roles = account.roles | selectattr('app_code', 'equalto', game.code) | list %}
        {% if roles %}
        <section class="pt-3.5">
          <div class="flex items-center justify-between gap-3">
            <div class="flex min-w-0 items-center gap-2"><span class="h-3 w-[3px] shrink-0 {% if game.code == 'arknights' %}bg-[#23BAFC]{% else %}bg-[#B4AC00]{% endif %}"></span><h2 class="text-[11px] font-bold tracking-wider text-[#080808]/65">{{ game.title }}</h2></div>
            <img src="{{ game.wordmark }}" class="shrink-0 object-contain brightness-0 opacity-55 {% if game.code == 'arknights' %}h-4 w-auto{% else %}h-[11px] w-auto{% endif %}" alt="" />
          </div>
          <div class="divide-y divide-[#080808]/10">
            {% for role in roles %}{{ role_row(role, game) }}{% endfor %}
          </div>
        </section>
        {% else %}
        <div class="flex items-center justify-between gap-3 py-3 text-[11px] tracking-wide text-[#080808]/60"><span>{{ game.title }}</span><span>暂无角色</span></div>
        {% endif %}
        {% endfor %}
      </div>
    </article>
    {% endfor %}
  </div>

  <section class="mx-[30px] mt-5 border-t border-[#080808]/20 pt-3.5">
    {% if props.mode == 'unbind_confirmation' %}
    <div class="flex items-start gap-3 border-l-2 border-[#BD665B] pl-3">
      <div class="flex-1"><div class="text-[12px] font-bold text-[#793F38]">确认后将删除所选账号的角色与抽卡记录</div><div class="mt-1.5 text-[11px] text-[#080808]/65">回复「确认」继续，其他回复将取消本次操作</div></div>
      <span class="shrink-0 text-[12px] text-[#793F38]">30 秒</span>
    </div>
    {% elif props.mode == 'unbind_selection' %}
    <div class="flex items-center justify-between gap-3 text-[12px] text-[#080808]/75"><span>请回复账号序号，或回复「全部」「取消」</span><span class="shrink-0">60 秒</span></div>
    {% elif props.mode == 'bind_confirmation' %}
    {% set new_accounts = props.accounts | selectattr('state', 'equalto', 'pending_bind') | list %}
    {% if new_accounts and not (new_accounts[0].roles | selectattr('is_available') | list) %}
    <div class="border-l-2 border-[#D0685E] pl-3 text-[12px] text-[#793F38]">暂无可绑定的角色，不会保存账号</div>
    {% else %}
    <div class="flex items-center justify-between gap-3 border-l-2 border-[#23BAFC] pl-3 text-[12px] text-[#080808]/75"><span>核对角色信息后，回复「确认」保存，或「取消」放弃</span><span class="shrink-0">60 秒</span></div>
    {% endif %}
    {% else %}
    <div class="flex items-start gap-4 text-[#080808]/85">
      <span class="mt-0.5 shrink-0 text-[12px] font-bold">切换默认角色</span>
      <div class="flex-1 space-y-1.5 text-[13px] leading-4"><div class="flex items-center gap-2"><span class="h-1.5 w-1.5 bg-[#23BAFC]"></span><span class="font-[Bender]">sk char set ark</span> &lt;序号&gt;</div><div class="flex items-center gap-2"><span class="h-1.5 w-1.5 bg-[#B4AC00]"></span><span class="font-[Bender]">sk char set ef</span> &lt;序号&gt;</div></div>
      <span class="text-[11px] text-[#080808]/80">角色序号按游戏分别计算</span>
    </div>
    {% endif %}
  </section>
  {% else %}
  <section class="mx-[30px] mt-6 rounded-[4px] bg-[#F4F5EF]/75 px-5 py-14 text-center">
    <h2 class="text-[20px] font-bold text-[#080808]/75">尚未绑定森空岛账号</h2>
    <p class="mt-3 text-[12px] text-[#080808]/65">使用 <span class="font-[Bender]">sk bind</span> 或 <span class="font-[Bender]">sk qrcode</span> 绑定账号</p>
  </section>
  {% endif %}
  <footer class="px-[30px] pt-6 pb-5 text-center font-[Bender] text-[11px] tracking-wider text-[#080808]/70">Generated by nonebot-plugin-skland</footer>
</main>
</body>
</html>
{% endautoescape %}
