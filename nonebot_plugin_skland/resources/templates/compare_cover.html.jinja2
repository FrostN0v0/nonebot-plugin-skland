<!DOCTYPE html>
<html lang="zh-CN">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>Operator Compare Cover</title>
  <style>
    {% include "index.css" %}
  </style>
</head>
<body class="m-0 overflow-hidden bg-[#1a1a1a] font-sans">
  <main class="box-border flex h-[1080px] w-[1920px] items-center justify-center bg-[radial-gradient(ellipse_at_center,#2c2c2c_0%,#141414_70%)] px-10 py-8">
    <section class="flex max-h-full w-full max-w-[1840px] flex-wrap content-center items-center justify-center gap-x-8 gap-y-7">
      {% for player in players %}
      <article
        class="relative h-[300px] w-[880px] overflow-hidden rounded-md shadow-[0_12px_28px_rgba(0,0,0,0.45)]"
      >
        {% if player.cover_bg %}
        <img
          class="absolute top-0 left-0 h-full w-auto max-w-none"
          src="{{ player.cover_bg }}"
          alt=""
        />
        {% else %}
        <div class="absolute inset-0 bg-gradient-to-br from-[#3a3a3a] to-[#1b1b1b]"></div>
        {% endif %}
        <div class="absolute inset-0 bg-gradient-to-r from-black/15 via-[#101010]/55 to-[#0a0a0a]/92"></div>

        <div class="absolute top-5 left-5 z-10 flex size-[52px] items-center justify-center rounded-full bg-[#080309]/85 ring-[3px] ring-[#f0f0f0]/70">
          <span class="font-[Akrobat] text-[22px] leading-none font-bold text-[#FBFBF3]">{{ player.status.level }}</span>
        </div>

        <div class="absolute top-1/2 right-10 z-10 flex -translate-y-1/2 items-center gap-5">
          <div class="text-right">
            <h1 class="m-0 max-w-[420px] truncate font-[Akrobat] text-[34px] leading-tight font-bold text-white [text-shadow:0_2px_8px_rgba(0,0,0,0.65)]">
              {{ player.status.name }}
            </h1>
            <p class="mt-3 m-0 font-[Bender] text-lg tracking-wide text-[#ff6b6b]">
              ID {{ player.status.uid }}
            </p>
          </div>
          <img
            class="size-[88px] shrink-0 object-cover shadow-[inset_0_1px_0_rgba(255,255,255,0.08),0_4px_10px_rgba(0,0,0,0.55),0_0_0_3px_#FBFBF3]"
            src="{{ player.status.avatar.url }}"
            alt="avatar"
          />
        </div>
      </article>
      {% endfor %}
    </section>
  </main>
</body>
</html>
