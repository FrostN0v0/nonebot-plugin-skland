{% from "ef_gacha_macros.html.jinja2" import category_header, pool_card %}
{% autoescape true %}
<!DOCTYPE html>
<html lang="zh-CN">
<head>
<meta charset="UTF-8" />
<title>Endfield Gacha History</title>
<style>{% include "index.css" %}</style>
</head>
<body class="m-0 bg-[#111111]">
{% set record = props.record %}
<div id="ef-pages"></div>
<template id="ef-page-template">
<section class="ef-page bound-roles-dossier relative flex flex-col p-4 gap-3 text-[#080808]">
    <header class="bound-roles-header relative overflow-hidden rounded-[4px] px-4 pt-4 pb-5 text-white">
        <div class="bound-roles-hatch pointer-events-none absolute -top-8 right-[-20px] h-40 w-24 -rotate-[14deg] opacity-20"></div>
        <div class="relative flex items-center justify-between gap-4">
            <div class="flex min-w-0 items-center gap-3 flex-1">
                {% if props.avatar_url %}<img src="{{ props.avatar_url }}" alt="玩家头像" class="w-12 h-12 shrink-0 border border-white/35 object-cover" />{% else %}<div class="w-12 h-12 shrink-0 border border-white/35 flex items-center justify-center font-[Akrobat] text-[#E3D600] text-xl">EF</div>{% endif %}
                <div class="min-w-0">
                    <img src="../images/endfield/name_title.png" alt="明日方舟：终末地" class="h-2.5 w-auto brightness-0 invert opacity-70" />
                    <h1 class="mt-1 text-xl leading-7 font-bold font-[Akrobat] break-words">{{ props.nickname }}</h1>
                    <div class="mt-1 text-[10px] font-[Bender] text-white/65">UID {{ props.role_id }}{% if props.server_name %} · {{ '国服' if props.server_name == 'China' else props.server_name }}{% endif %}</div>
                </div>
            </div>
            <div data-overview class="flex items-center gap-4 shrink-0">
                <div class="text-center"><div class="font-[Akrobat] text-[32px] leading-9">{{ record.total_pulls }}<span class="text-xs text-white/65 ml-1">抽</span></div><span class="text-[10px] text-white/60">已记录寻访</span></div>
                <div class="border-l border-white/15 pl-4 text-[10px] text-white/60"><div>角色 <b class="font-[Akrobat] text-sm text-[#E3D600]">{{ record.char_total_pulls }}</b></div><div class="mt-1">武器 <b class="font-[Akrobat] text-sm text-white/85">{{ record.weapon_total_pulls }}</b></div></div>
            </div>
        </div>
        <div class="absolute inset-x-0 bottom-0 flex h-1"><span class="w-8 bg-[#92999C]"></span><span class="flex-1 bg-[#E3D600]"></span></div>
    </header>
    <div data-overview class="ef-stat-grid">
        {% for category in props.categories %}
        <section class="ef-stat-card bound-roles-account" data-category="{{ category.key }}">
            <h2 class="ef-stat-title">{{ category.title }}</h2>
            <div class="ef-stat-total">{{ category.total_pulls }}<span>抽{% if category.free_pulls %} · 含免费 {{ category.free_pulls }} 抽{% endif %}</span></div>
            <div class="ef-stat-details">
                <span>6★ <b>{{ category.six_count }}</b>{% if category.key in ('special', 'rerun', 'weapon', 'rerun_weapon') %} / 歪 <b>{{ category.spook_count if category.spook_count is not none else '-' }}</b>{% endif %}</span>
                <span>{{ category.average_label }} <b>{{ '%.1f'|format(category.average) if category.average is not none else '-' }}</b></span>
            </div>
        </section>
        {% endfor %}
        <section class="ef-stat-card bound-roles-account" data-category="quota">
            <h2 class="ef-stat-title">武库配额</h2>
            <div class="ef-stat-total">{{ record.arsenal_quota_net }}<span>净值</span></div>
            <div class="ef-stat-details"><span>产出 <b>{{ record.char_arsenal_quota_earned }}</b></span><span>消耗 <b>{{ record.weapon_arsenal_quota_consumed }}</b></span></div>
        </section>
    </div>
    <div class="flex flex-wrap justify-between gap-x-3 text-[10px] font-[Bender] {{ 'text-[#855F25]' if props.is_cached else 'text-[#080808]/60' }}">
        <span>{% if props.is_cached %}本地记录 · 本次未更新{% else %}已更新 · 新增 {{ props.new_count }} 条{% endif %}{% if props.notice %} · {{ props.notice }}{% endif %}</span>
        <span class="whitespace-nowrap">第 <span data-page-number>1</span> / <span data-page-total>1</span> 页</span>
    </div>
    <main class="ef-sections"></main>
    <footer class="ef-footer">
        <div>Generated by nonebot-plugin-skland</div>
    </footer>
</section>
</template>
<div id="ef-source" class="ef-source">
    {% for category in props.categories %}
    {% if category.pools %}
    <section class="ef-category" data-category="{{ category.key }}" data-columns="{{ [category.pools | length, 3] | min }}">
        {{ category_header(category) }}
        <div class="ef-category-pools">
            {% for pool in category.pools %}{{ pool_card(pool, category.key) }}{% endfor %}
        </div>
    </section>
    {% endif %}
    {% endfor %}
</div>
<script>{% include "ef_gacha.js" %}</script>
</body>
</html>
{% endautoescape %}
