{% macro five_stars(items) %}
{% autoescape true %}
{% if items %}
<div class="flex flex-wrap gap-0.5 mt-0.5">
    {% for item in items %}
    <div class="relative inline-block" title="{{ item.item_name }} ×{{ item.count }}">
        <img src="{{ item.item_id | ef_charId_to_avatarUrl }}" alt="" class="w-5 h-5 rounded-xs bg-[#D3D6D1] object-cover" />
        {% if item.count > 1 %}<div class="absolute right-0 bottom-0 min-w-2.5 h-2.5 bg-[#080808]/65 text-white text-[8px] flex items-center justify-center">{{ item.count }}</div>{% endif %}
    </div>
    {% endfor %}
</div>
{% endif %}
{% endautoescape %}
{% endmacro %}

{% macro event_card(event) %}
{% autoescape true %}
<section class="ef-event flex flex-col gap-0.5 border-t border-[#080808]/8{% if event.is_free %} border-l-2 border-l-[#458AA4] bg-[#75BBCA]/10{% endif %}{% if event.six_stars | length >= 2 %} multi-six-bg{% endif %}" data-event-key="{{ event.key }}">
    {% if event.is_free or event.six_stars | length >= 2 %}
    <div class="flex items-center justify-between gap-2 px-2 pt-1 text-[9px] font-[Akrobat] font-bold {{ 'text-[#35667D]' if event.is_free else 'text-[#337047]' }}">
        <span>{% if event.is_free %}免费{{ event.pull_count }}连{% endif %}{% if event.six_stars | length >= 2 %}{{ ' · ' if event.is_free else '十连' }}{{ event.six_stars | length }}金{% endif %}</span>
        {% if event.is_free and not event.six_stars %}<time class="text-[#080808]/50 text-[8px] font-[Bender] font-normal">{{ event.gacha_ts | format_timestamp_md }}</time>{% endif %}
    </div>
    {% endif %}
    {% for six in event.six_stars %}
    <div class="flex flex-col px-2 py-1.5" data-six-key="{{ event.key }}:{{ loop.index0 }}">
        <div class="flex items-start gap-1.5">
            <div class="flex flex-col items-center flex-shrink-0">
                <div class="w-8 h-8 rounded-xs overflow-hidden bg-[#D3D6D1]"><img src="{{ six.item_id | ef_charId_to_avatarUrl }}" class="w-full h-full object-cover" alt="" /></div>
                <time class="text-[#080808]/50 text-[8px] font-[Bender] mt-0.5">{{ event.gacha_ts | format_timestamp_md }}</time>
            </div>
            <div class="flex flex-col flex-1 gap-0.5 min-w-0">
                <div class="flex flex-wrap items-center gap-1">
                    <span class="text-[#080808]/90 font-[Akrobat] font-bold text-xs break-words">{{ six.item_name }}</span>
                    {% if six.is_spook %}<span class="text-[8px] text-white bg-[#A65D59] rounded-xs px-0.5">歪</span>{% endif %}
                    {% if six.is_up %}<span class="text-[8px] text-[#4D4B12] bg-[#E3D600]/60 rounded-xs px-0.5">UP</span>{% endif %}
                    {% if not event.is_free and six.is_new %}<span class="text-[8px] text-white bg-[#548671] rounded-xs px-0.5">NEW</span>{% endif %}
                    {% if six.pity_count is not none and (six.pity_count <= 10 or six.pity_count >= 70) %}<span class="text-[8px] text-white font-[Bender] px-1 rounded-xs whitespace-nowrap {{ 'bg-[#548671]' if six.pity_count <= 10 else 'bg-[#B96955]' }}">{{ '超欧' if six.pity_count <= 10 else '超非' }}</span>{% endif %}
                </div>
                {% if event.is_free %}
                <div class="h-4 rounded-xs flex items-center" style="background: linear-gradient(90deg, #7FBFCB99, #C0DAD288);"><span class="text-[#244C5B] text-[10px] font-[Bender] font-bold px-1.5 whitespace-nowrap">不计入保底</span></div>
                {% else %}
                {% set bar_class = 'red-stripe-bar' if six.pity_count >= 70 else 'yellow-stripe-bar' if six.pity_count >= 45 else 'green-stripe-bar' %}
                <div class="h-4 rounded-xs flex items-center {{ bar_class }}" style="width: {{ [15 + six.pity_count / 80 * 85, 100] | min }}%; min-width: 36px;"><span class="text-[#080808]/85 text-[10px] font-[Bender] font-bold px-1 whitespace-nowrap">{{ six.pity_count }}抽</span></div>
                {% endif %}
                {{ five_stars(six.five_stars) }}
                {% if loop.last %}{{ five_stars(event.five_stars) }}{% endif %}
            </div>
        </div>
    </div>
    {% else %}
    <div class="flex flex-col gap-0.5 px-2 py-1.5">
        <div class="h-4 rounded-xs flex items-center" style="background: linear-gradient(90deg, #7FBFCB99, #C0DAD288);"><span class="text-[#244C5B] text-[10px] font-[Bender] font-bold px-1.5">未出6★</span></div>
        {{ five_stars(event.five_stars) }}
    </div>
    {% endfor %}
</section>
{% endautoescape %}
{% endmacro %}

{% macro pool_card(view, index) %}
{% autoescape true %}
{% set pool = view.pool %}
{% set colors = {"special":"#C0B642", "weapon":"#C69254", "joint":"#91849C", "standard":"#628F83", "beginner":"#6790A0"} %}
{% set color = colors[pool.pool_category] %}
<article class="ef-pool bound-roles-account flex flex-col w-full rounded-[4px] border border-white/40 overflow-hidden bg-[#F4F5EF]/85" data-pool-key="{{ index }}" data-category="{{ pool.pool_category }}">
    <header class="ef-pool-head">
        {% if pool.up6_img %}
        <div class="w-full overflow-hidden" style="aspect-ratio: 1151/146;">
            <img src="{{ pool.up6_img }}" alt="" class="w-full h-full object-cover object-center" />
        </div>
        {% else %}
        <div class="h-0.5" style="background-color: {{ color }};"></div>
        {% endif %}
        <div class="px-2 py-2">
            <div class="flex items-start justify-between gap-2">
                <h2 class="flex-1 min-w-0 text-[#080808]/90 font-[Akrobat] font-bold text-xs break-words">{{ pool.pool_name }}</h2>
                <span class="ef-pool-part shrink-0 text-[#080808]/50 font-[Bender]" data-pool-part></span>
            </div>
            <div class="mt-1 flex flex-wrap items-center justify-between gap-x-2 gap-y-1 text-[9px] leading-4 text-[#080808]/55 font-[Bender]">
                {% if pool.up_six_chars %}
                <div class="flex flex-wrap items-center gap-0.5">
                    <span class="text-[#77721E] text-[8px] font-[Akrobat] font-bold">UP</span>
                    {% for item_id in pool.up_six_chars %}<img src="{{ item_id | ef_charId_to_avatarUrl }}" alt="" class="w-4 h-4 rounded-xs bg-[#D3D6D1] object-cover" />{% endfor %}
                </div>
                {% endif %}
                <span class="whitespace-nowrap"><b class="text-[#080808]/85 text-[11px]">{{ pool.total_pulls }}</b> 抽</span>
                <span class="whitespace-nowrap">6★ <b class="text-[#8F6D15] text-[11px]">{{ pool.total_six_stars }}</b>{% if pool.show_spook_stats %}<span class="text-[#080808]/30"> / </span><b class="text-[#A0524C] text-[11px]">{{ pool.total_six_spook }}</b> 歪{% endif %}</span>
                <span class="whitespace-nowrap">已垫 <b class="text-[#080808]/85 text-[11px]">{{ pool.pity_count }}</b></span>
            </div>
        </div>
    </header>
    <div class="ef-events flex flex-col gap-0.5 bg-white/35">{% for event in view.events %}{{ event_card(event) }}{% endfor %}</div>
</article>
{% endautoescape %}
{% endmacro %}
