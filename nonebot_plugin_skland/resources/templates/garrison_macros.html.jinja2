{% macro garrison_profile(view, record=none) %}
{% autoescape true %}
<div class="garrison-profile{% if record %} garrison-profile-settlement{% endif %}">
  <div class="garrison-player-avatar avater-shadow">
    {% if view.avatar_url %}<img src="{{ view.avatar_url }}" alt="博士头像" />{% else %}<span>博士</span>{% endif %}
  </div>
  <div class="garrison-player-info">
    <h2>{% if record %}<img class="garrison-player-name-bg" src="{{ 'id_info_bg.png' | garrison_asset_url }}" alt="" aria-hidden="true" />{% endif %}<span>Dr. {{ view.nickname }}</span></h2>
    {% if record %}
    <div class="garrison-trophy-summary">
      <div class="garrison-trophy-rank"><img src="{{ record.trophy_icon_url }}" alt="奖杯段位" /><span><img src="{{ 'id_info_cup_icon.png' | garrison_asset_url }}" alt="" aria-hidden="true" />{{ record.trophy_after }}</span></div>
      <div class="garrison-trophy-award"><span><img src="{{ 'id_info_cup_icon.png' | garrison_asset_url }}" alt="" aria-hidden="true" />获得奖杯</span><strong{% if record.trophy_change < 0 %} class="garrison-trophy-loss"{% endif %}>{{ record.trophy_change }}</strong></div>
    </div>
    {% else %}
    <div class="garrison-player-meta">{% if view.server_name %}<span class="garrison-server reg-shadow-blue">{{ view.server_name }}</span>{% endif %}<span>Lv. {{ view.level }}</span><span>UID {{ view.uid }}</span></div>
    {% endif %}
  </div>
</div>
{% endautoescape %}
{% endmacro %}

{% macro garrison_header(view, compact=false) %}
{% autoescape true %}
<header class="garrison-header{% if compact %} garrison-header-compact{% endif %}">
  {% if view.background_url %}<img class="garrison-season-background" src="{{ view.background_url }}" alt="" />{% endif %}
  {{ garrison_profile(view) }}
  <div class="garrison-heading"><img class="garrison-wordmark" src="{{ 'common_logo.png' | garrison_asset_url }}" alt="卫戍协议" /><h1>卫戍协议</h1><p>{{ view.season_name }}</p></div>
</header>
{% endautoescape %}
{% endmacro %}

{% macro garrison_footer(view=none) %}
{% autoescape true %}
<footer class="garrison-footer">{% if view %}<span>{% if view.server_name %}{{ view.server_name }} · {% endif %}Lv. {{ view.level }} · UID {{ view.uid }}</span>{% endif %}<span>Generated by nonebot-plugin-skland</span></footer>
{% endautoescape %}
{% endmacro %}

{% macro garrison_item(item, recent=false) %}
{% autoescape true %}
<article class="{{ 'garrison-strategy-stat' if recent else 'garrison-item' }}">
  {% if item.icon_url or item.badge_icon_url %}<div class="garrison-item-icon">{% if item.icon_url %}<img class="garrison-strategy-icon" src="{{ item.icon_url }}" alt="" />{% endif %}{% if item.badge_icon_url %}<img class="garrison-strategy-badge" src="{{ item.badge_icon_url }}" alt="{{ item.badge }}" />{% endif %}</div>{% endif %}
  <div class="garrison-item-copy">
    {% if recent %}<p class="garrison-preference-count"><strong>{{ item.recent_count }}</strong><span>场</span></p>{% endif %}
    <div class="garrison-item-heading"><strong>{{ item.name or item.id or '未命名' }}</strong>{% if not recent and item.count is not none %}<span class="garrison-count">×{{ item.count }}</span>{% endif %}</div>
    {% if recent %}<p class="garrison-preference-detail"><span>胜率</span><strong>{% if item.win_percent is not none %}{{ '%.1f' | format(item.win_percent) }}<small>%</small>{% else %}—{% endif %}</strong></p>{% endif %}
  </div>
</article>
{% endautoescape %}
{% endmacro %}

{% macro garrison_bosses(items, compact=false) %}
{% autoescape true %}
<div class="garrison-bosses{% if compact %} garrison-bosses-compact{% endif %}">
  {% for boss in items %}
  <div class="garrison-boss" data-boss-id="{{ boss.id }}" title="{{ boss.name }} · {{ boss.status_label }}">
    <div class="garrison-boss-emblem">
      <img class="garrison-boss-frame" src="{{ ('round_info_boss_bg' ~ ('_sp' if boss.is_hidden else '') ~ '.png') | garrison_asset_url }}" alt="" aria-hidden="true" />
      {% if boss.icon_url %}<img class="garrison-boss-portrait" src="{{ boss.icon_url }}" alt="{{ boss.name }}" />{% else %}<span class="garrison-boss-fallback">{{ boss.name }}</span>{% endif %}
      <img class="garrison-boss-kind" src="{{ ('round_info_boss_icon' ~ ('_sp' if boss.is_hidden else '') ~ '.png') | garrison_asset_url }}" alt="{{ '隐秘核心领袖' if boss.is_hidden else '普通领袖' }}" />
      {% if boss.is_killed %}<img class="garrison-boss-cleared" src="{{ ('round_info_boss_complete' ~ ('_sp' if boss.is_hidden else '') ~ '.png') | garrison_asset_url }}" alt="已击败" />{% else %}<span class="garrison-boss-undefeated" aria-label="未击败">×</span>{% endif %}
    </div>
    {% if boss.icon_url %}<span class="garrison-boss-name">{{ boss.name }}</span>{% endif %}
  </div>
  {% endfor %}
</div>
{% endautoescape %}
{% endmacro %}

{% macro garrison_bonds(items, large=false) %}
{% autoescape true %}
<div class="garrison-bonds{% if large %} garrison-bonds-large{% endif %}">
  {% for item in items %}
  <div class="garrison-bond{% if item.badge == '未激活' %} garrison-bond-inactive{% endif %}" title="{{ item.name or item.id }}{% if item.count is not none %} · {{ item.count }}{% endif %}{% if item.badge %} · {{ item.badge }}{% endif %}">
    <div class="garrison-bond-emblem">
      <img class="garrison-bond-disc" src="{{ 'img_bond_bkg.png' | garrison_asset_url }}" alt="" aria-hidden="true" />
      {% if item.icon_url %}<img class="garrison-bond-icon" src="{{ item.icon_url }}" alt="{{ item.name or item.id }}" />{% else %}<span class="garrison-bond-fallback">{{ item.name or item.id }}</span>{% endif %}
    </div>
    {% if item.count is not none %}<span class="garrison-bond-count"><img src="{{ 'matte_num.png' | garrison_asset_url }}" alt="" aria-hidden="true" /><b>{{ item.count }}</b></span>{% endif %}
  </div>
  {% else %}<span class="garrison-muted">—</span>{% endfor %}
</div>
{% endautoescape %}
{% endmacro %}

{% macro garrison_bond_stat(item) %}
{% autoescape true %}
<article class="garrison-bond-stat">
  {{ garrison_bonds([item]) }}
  <p class="garrison-preference-count"><strong>{{ item.recent_count }}</strong><span>场</span></p>
  <h4 class="garrison-preference-name">{{ item.name or item.id or '未命名' }}</h4>
  <p class="garrison-preference-detail"><span>最高</span><strong>{% if item.max_layer is not none %}{{ item.max_layer }}<small>层</small>{% else %}—{% endif %}</strong></p>
</article>
{% endautoescape %}
{% endmacro %}

{% macro garrison_title_group(label, items, other=false) %}
{% autoescape true %}
<section class="garrison-title-group{% if other %} garrison-title-group-other{% endif %}">
  <h3 class="garrison-section-label">{{ label }}</h3>
  <div class="garrison-title-list">
    {% for title in items %}
    <div class="garrison-title"><span>{% if title.icon_url %}<img src="{{ title.icon_url }}" alt="" aria-hidden="true" />{% endif %}{{ title.name or title.id or '未命名' }}</span><b>{% if title.count is not none %}×{{ title.count }}{% else %}—{% endif %}</b></div>
    {% else %}<p class="garrison-muted">暂无{{ label }}记录</p>{% endfor %}
  </div>
</section>
{% endautoescape %}
{% endmacro %}

{% macro garrison_title_radar(view) %}
{% autoescape true %}
{% set axes = [(0, -1), (0.8660254, -0.5), (0.8660254, 0.5), (0, 1), (-0.8660254, 0.5), (-0.8660254, -0.5)] %}
<figure class="garrison-title-dimensions">
  <figcaption class="garrison-section-label">六维评价</figcaption>
  <div class="garrison-title-radar">
    <svg viewBox="0 0 360 320" role="img" aria-label="六维称号分布{% if not view.title_radar_complete %}，部分维度未提供{% endif %}">
      {% for step in range(1, 4) %}
      <polygon class="garrison-radar-grid" points="{% for dx, dy in axes %}{{ (180 + dx * 30 * step) | round(2) }},{{ (160 + dy * 30 * step) | round(2) }} {% endfor %}" />
      {% endfor %}
      {% for dx, dy in axes %}<line class="garrison-radar-axis" x1="180" y1="160" x2="{{ (180 + dx * 90) | round(2) }}" y2="{{ (160 + dy * 90) | round(2) }}" />{% endfor %}
      {% if view.title_radar_complete %}
      <polygon class="garrison-radar-data" points="{% for dimension in view.title_dimensions %}{% set dx, dy = axes[loop.index0] %}{% set radius = 90 * dimension.count / view.title_scale %}{{ (180 + dx * radius) | round(2) }},{{ (160 + dy * radius) | round(2) }} {% endfor %}" />
      {% endif %}
    </svg>
    {% for dimension in view.title_dimensions %}
    <div class="garrison-dimension garrison-dimension-{{ loop.index0 }}" data-dimension="{{ dimension.key }}"><strong>{{ dimension.count if dimension.count is not none else '—' }}</strong><span>{% if dimension.icon_url %}<img src="{{ dimension.icon_url }}" alt="" aria-hidden="true" />{% endif %}{{ dimension.label }}</span></div>
    {% endfor %}
  </div>
  {% if not view.title_radar_complete %}<p class="garrison-radar-note">部分维度未提供</p>{% endif %}
</figure>
{% endautoescape %}
{% endmacro %}

{% macro garrison_equipment(equipment) %}
{% autoescape true %}
{% set equipment_count = equipment | length %}
<div class="garrison-equipment-list{% if equipment_count > 2 %} garrison-equipment-dense{% endif %}"{% if equipment_count > 2 %} style="--equipment-columns: {{ (equipment_count + 1) // 2 }}; --equipment-rows: 2"{% endif %}>
  {% for item in equipment %}
  <div class="garrison-equipment-slot garrison-equipment-chip{% if item.badge == '升级' %} garrison-equipment-chip-upgraded{% endif %}" title="{{ item.name or item.id or '未知装备' }}{% if item.count is not none %} ×{{ item.count }}{% endif %}{% if item.badge %} · {{ item.badge }}{% endif %}">
    {% if item.icon_url %}<img src="{{ item.icon_url }}" alt="{{ item.name or item.id or '未知装备' }}" />{% else %}<span>{{ item.name or item.id or '未知装备' }}</span>{% endif %}
    {% if item.count is not none %}<b>×{{ item.count }}</b>{% endif %}
  </div>
  {% endfor %}
  {% for index in range(2 - equipment_count) %}<div class="garrison-equipment-slot garrison-equipment-empty" aria-hidden="true"></div>{% endfor %}
</div>
{% endautoescape %}
{% endmacro %}

{% macro garrison_operator_tile(operator) %}
{% autoescape true %}
<article class="garrison-operator-mini" data-tier="{{ operator.tier }}" data-elite="{{ operator.elite_phase }}" data-rank="{{ operator.rank_label }}">
  <div class="garrison-operator-art">
    {% if operator.char_id %}<img class="garrison-operator-portrait" src="{{ operator.half_portrait_url }}" alt="{{ operator.name or operator.char_id }}" />{% else %}<span>{{ operator.name or '未知干员' }}</span>{% endif %}
    <span class="garrison-operator-tier{% if operator.rank_label == '精锐' %} garrison-tier-elite{% endif %}">{% if operator.tier_icon_url %}<img src="{{ operator.tier_icon_url }}" alt="{{ operator.tier }}阶" />{% else %}{{ operator.tier }}{% endif %}</span>
    {% if operator.skill_id %}<img class="garrison-operator-skill" src="{{ operator.skill_id | ark_skill_icon_url }}" alt="所选技能" />{% endif %}
    <strong class="garrison-operator-name">{{ operator.name or operator.char_id or '未知干员' }}</strong>
  </div>
  <div class="garrison-operator-training" title="{{ operator.rank_label }} · 精英 {{ operator.elite_phase }} · Lv. {{ operator.level }}">
    <img class="garrison-training-frame" src="{{ 'operator_lv_bg.png' | garrison_asset_url }}" alt="" aria-hidden="true" />
    <img class="garrison-training-elite" src="../images/ark_card/elite/elite_{{ operator.elite_phase }}.png" alt="{{ operator.rank_label }} · 精英 {{ operator.elite_phase }}" />
    <strong>{{ operator.level }}</strong>
  </div>
  {{ garrison_equipment(operator.equipment) }}
</article>
{% endautoescape %}
{% endmacro %}

{% macro garrison_record_title(record) %}
{% autoescape true %}
{% if record.title %}<span class="garrison-earned-title">{% if record.title_icon_url %}<img src="{{ record.title_icon_url }}" alt="" aria-hidden="true" />{% endif %}{{ record.title }}</span>{% endif %}
{% endautoescape %}
{% endmacro %}

{% macro garrison_difficulty(label, background_url) %}
{% autoescape true %}
<span class="garrison-difficulty{% if background_url %} garrison-difficulty-decorated{% endif %}">{% if background_url %}<img src="{{ background_url }}" alt="" aria-hidden="true" />{% endif %}<b>{{ label }}</b></span>
{% endautoescape %}
{% endmacro %}

{% macro garrison_record_header(record) %}
{% autoescape true %}
<header class="garrison-record-head">
  <div class="garrison-record-result"><h3>{{ record.result_label }}</h3>{{ garrison_record_title(record) }}{% if record.is_favored %}<span class="garrison-favored">已收藏</span>{% endif %}</div>
  <div class="garrison-record-caption"><span class="garrison-record-number">#{{ '%02d' | format(record.index) }}</span><span class="garrison-record-duration"><img src="{{ 'time_icon.png' | garrison_asset_url }}" alt="" aria-hidden="true" />用时 {{ record.duration_label }}</span>{% if record.ended_at > 0 %}<time><img src="{{ 'date_icon.png' | garrison_asset_url }}" alt="" aria-hidden="true" />{{ record.ended_at | format_timestamp_str }}</time>{% endif %}</div>
</header>
{% endautoescape %}
{% endmacro %}

{% macro garrison_record_row(record) %}
{% autoescape true %}
<article class="garrison-record gacha-info-shadow{% if record.success %} garrison-victory{% else %} garrison-interrupted{% endif %}" data-record-id="{{ record.record_id }}">
  <img class="garrison-record-map" src="{{ ('settlemen_personal_' ~ ('success' if record.success else 'fail') ~ '.png') | garrison_asset_url }}" alt="" aria-hidden="true" />
  {{ garrison_record_header(record) }}
  <div class="garrison-record-body">
    <div class="garrison-record-lineup">
      <div class="garrison-record-sidebar">
        <div class="garrison-record-summary">
          <div class="garrison-record-rounds"><strong>{{ record.rounds }}</strong><span>回合 · {{ record.mode_label }}</span></div>
          <div class="garrison-record-strategy">{{ garrison_item(record.strategy) }}</div>
        </div>
        {{ garrison_difficulty(record.difficulty_label, record.difficulty_background_url) }}
        {% if record.bosses %}<div class="garrison-record-bosses">{{ garrison_bosses(record.bosses, true) }}</div>{% endif %}
      </div>
      <div class="garrison-roster garrison-roster-compact{% if record.operators | length <= 8 %} garrison-roster-four{% endif %}">{% for operator in record.operators %}{{ garrison_operator_tile(operator) }}{% endfor %}</div>
    </div>
    {% if record.bonds %}<div class="garrison-record-bonds"><h4>本局盟约</h4>{{ garrison_bonds(record.bonds, true) }}</div>{% endif %}
  </div>
</article>
{% endautoescape %}
{% endmacro %}

{% macro garrison_record_detail(record, view) %}
{% autoescape true %}
<article class="garrison-record garrison-record-detail gacha-info-shadow{% if record.success %} garrison-victory{% else %} garrison-interrupted{% endif %}" data-record-id="{{ record.record_id }}">
  <img class="garrison-record-map" src="{{ ('settlemen_personal_' ~ ('success' if record.success else 'fail') ~ '.png') | garrison_asset_url }}" alt="" aria-hidden="true" />
  <div class="garrison-settlement">
    <aside class="garrison-settlement-result">
      <div class="garrison-settlement-brand"><img src="{{ 'common_logo.png' | garrison_asset_url }}" alt="卫戍协议" /><span>{{ view.season_name }}</span></div>
      <div class="garrison-settlement-outcome">
        <div class="garrison-settlement-strategy">{{ garrison_item(record.strategy) }}</div>
        <div class="garrison-settlement-outcome-copy">
          <div class="garrison-settlement-mode">{{ garrison_difficulty(record.difficulty_label, record.difficulty_background_url) }}<span>{{ record.mode_label }}</span></div>
          <h2>{{ record.result_label }}</h2>
        </div>
      </div>
      <div class="garrison-settlement-rounds">
        <div class="garrison-record-rounds"><span>通过回合</span><strong>{{ record.rounds }}</strong></div>
        {% if record.bosses %}{{ garrison_bosses(record.bosses) }}{% endif %}
        <div class="garrison-settlement-kills"><span>击杀</span><strong>{{ record.kill_count }}</strong></div>
        <div class="garrison-settlement-coins"><span>花费金币</span><strong>{{ record.coin_cost }}</strong></div>
      </div>
      {{ garrison_record_title(record) }}
      <div class="garrison-settlement-player">{{ garrison_profile(view, record) }}</div>
    </aside>
    <div class="garrison-settlement-main">
      <div class="garrison-roster garrison-detail-lineup{% if record.operators | length <= 8 %} garrison-roster-four{% endif %}">{% for operator in record.operators %}{{ garrison_operator_tile(operator) }}{% endfor %}</div>
      {{ garrison_bonds(record.bonds, true) }}
    </div>
    <div class="garrison-session-meta">
      <span>#{{ '%02d' | format(record.index) }}</span>
      <span class="garrison-record-duration"><img src="{{ 'time_icon.png' | garrison_asset_url }}" alt="" aria-hidden="true" />本局用时 {{ record.duration_label }}</span>
      {% if record.started_at > 0 %}<time data-event="start"><img src="{{ 'date_icon.png' | garrison_asset_url }}" alt="" aria-hidden="true" />开始 {{ record.started_at | format_timestamp_str }}</time>{% endif %}
      {% if record.ended_at > 0 %}<time data-event="end">结束 {{ record.ended_at | format_timestamp_str }}</time>{% endif %}
    </div>
  </div>
  {{ garrison_footer(view) }}
</article>
{% endautoescape %}
{% endmacro %}
