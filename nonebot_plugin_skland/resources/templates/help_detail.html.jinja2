{% autoescape true %}
{% from 'help_macros.html.jinja2' import help_header, help_footer %}
{% set item = props.function %}
{% set category_title = item.category_title if item else '其他功能' %}
<!DOCTYPE html>
<html lang="zh-CN">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{{ props.name }} · {{ item.func if item else '功能详情' }}</title>
  <style>{% include 'index.css' %}</style>
</head>
<body class="skland-help-body">
<main class="bound-roles-dossier skland-help-page skland-help-detail{% if props.variant == 'roster' %} skland-help-roster{% endif %} skland-help-category-{{ item.category if item else 'other' }}">
  {{ help_header(props, item.func if item else '功能详情', category_title ~ (' / 筛选速查' if props.variant == 'roster' else ' / 功能说明')) }}
  <div class="skland-help-content">
    {% if item %}
    <section class="bound-roles-account skland-help-command-panel">
      <div class="skland-help-panel-label">常用指令</div>
      {% if item.trigger_condition %}<div class="skland-help-prose skland-help-command">{{ layout(item.trigger_condition, props.markdown) }}</div>{% endif %}
      {% if item.trigger_method %}<div class="skland-help-condition"><span>使用条件</span><div class="skland-help-prose">{{ layout(item.trigger_method, props.markdown) }}</div></div>{% endif %}
    </section>
    {% if item.brief_des %}
    <section class="skland-help-summary"><h2>功能简介</h2><div class="skland-help-prose">{{ layout(item.brief_des, props.markdown) }}</div></section>
    {% endif %}
    <section class="bound-roles-account skland-help-detail-panel">
      <header class="skland-help-detail-heading"><h2>{{ '筛选与用法速查' if props.variant == 'roster' else '详细用法' }}</h2><span>{{ 'QUICK REFERENCE' if props.variant == 'roster' else 'FIELD GUIDE' }}</span></header>
      {% if item.detail_des %}<div class="skland-help-prose skland-help-detail-prose">{{ layout(item.detail_des, props.markdown) }}</div>{% else %}<p class="skland-help-muted">此功能暂未提供详细说明，请参考上方触发方式</p>{% endif %}
    </section>
    {% else %}
    <section class="bound-roles-account skland-help-empty"><h2>暂无功能详情</h2><p>使用下方帮助命令返回总览，查看当前可见功能</p></section>
    {% endif %}
  </div>
  {{ help_footer(props, true) }}
</main>
</body>
</html>
{% endautoescape %}
