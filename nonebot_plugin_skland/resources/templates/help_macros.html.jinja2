{% macro help_header(props, title, subtitle) %}
{% autoescape true %}
<header class="bound-roles-header skland-help-header">
  <div class="bound-roles-hatch skland-help-hatch" aria-hidden="true"></div>
  <div class="skland-help-header-content">
    <div class="skland-help-heading">
      <div class="skland-help-eyebrow"><span></span>森空岛 / 使用档案</div>
      <h1>{{ title }}</h1>
      <p>{{ subtitle }}</p>
    </div>
    <div class="skland-help-stamp">
      <span class="skland-help-stamp-label">{{ props.name }}</span>
      {% if props.version %}<span class="skland-help-version">v{{ props.version }}</span>{% endif %}
      {% if props.variant == 'overview' %}
      <strong>{{ '%02d' | format(props.function_count) }}</strong>
      <span class="skland-help-stamp-label">可见功能</span>
      {% else %}
      <strong>{{ '%02d' | format(props.function.index) if props.function and props.function.index is not none else '—' }}</strong>
      <span class="skland-help-stamp-label">功能档案</span>
      {% endif %}
    </div>
  </div>
</header>
<div class="skland-help-rule" aria-hidden="true"><span></span><span></span><span></span></div>
{% endautoescape %}
{% endmacro %}

{% macro help_section(section, props, layout) %}
{% autoescape true %}
<section class="bound-roles-account skland-help-section skland-help-category-{{ section.category }}">
  <header class="skland-help-section-heading">
    <div><span class="skland-help-section-subtitle">{{ section.subtitle }}</span><h2>{{ section.title }}</h2></div>
    {% if section.category == 'arknights' %}
    <img class="skland-help-wordmark skland-help-wordmark-arknights" src="../images/ark_card/raft_dec_text_01.png" alt="" />
    {% elif section.category == 'endfield' %}
    <img class="skland-help-wordmark skland-help-wordmark-endfield" src="../images/endfield/name_title.png" alt="" />
    {% endif %}
  </header>
  <div class="skland-help-items">
    {% for item in section.items %}
    <article class="skland-help-item">
      <span class="skland-help-item-index">{{ '%02d' | format(item.index) if item.index is not none else '—' }}</span>
      <div class="skland-help-item-content">
        <h3>{{ item.func }}</h3>
        {% if item.brief_des %}<div class="skland-help-prose skland-help-item-brief">{{ layout(item.brief_des, props.markdown) }}</div>{% endif %}
        {% if item.trigger_condition %}<div class="skland-help-condition"><span>指令</span><div class="skland-help-prose">{{ layout(item.trigger_condition, props.markdown) }}</div></div>{% endif %}
      </div>
    </article>
    {% else %}
    <p class="skland-help-section-empty">此栏目暂无可见功能</p>
    {% endfor %}
  </div>
</section>
{% endautoescape %}
{% endmacro %}

{% macro help_footer(props, is_detail=false) %}
{% autoescape true %}
<footer class="skland-help-footer">
  <div class="skland-help-navigation">
    <span>{{ '返回总览' if is_detail else '查看详情' }}</span>
    <div><code>{{ props.help_command }}{% if not is_detail %} &lt;功能名称或编号&gt;{% endif %}</code></div>
  </div>
  {% if props.showing_hidden and props.user_can_see_hidden is not false %}<p class="skland-help-visibility">当前菜单包含隐藏功能；实际使用仍以命令权限为准</p>{% endif %}
  <p class="skland-help-credit">Generated by nonebot-plugin-skland</p>
</footer>
{% endautoescape %}
{% endmacro %}
